# MySQL connection string for the production Node API.
MYSQL_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/myeonn

# Set these after you host the API separately from Firebase Hosting.
PORT=5177
CORS_ORIGIN=https://myeonn-c90db.web.app
COOKIE_SECURE=true

# Razorpay online payments. Keep the secret values only on the Node API host.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
